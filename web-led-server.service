[Unit]
Description=Web LED Control Server (smartphone/browser control)
After=pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/basketball/raspi2-led
ExecStart=/usr/bin/python3 -u web_led_server.py 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
