[Unit]
Description=USB HID Copy/Paste Button LED Daemon
After=pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/basketball/raspi2-led
ExecStart=/usr/bin/python3 -u button_led_daemon.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
