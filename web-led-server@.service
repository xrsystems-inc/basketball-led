# テンプレートユニット。実行ユーザー名をインスタンス名として渡す。
#   sudo systemctl enable --now web-led-server@<ユーザー名>.service
# %i がユーザー名とホームディレクトリの両方に展開される。
[Unit]
Description=Web LED Control Server (smartphone/browser control)
After=pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/basketball/raspi2-led
ExecStart=/usr/bin/python3 -u web_led_server.py 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
